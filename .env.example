# Copy to .env and fill in. .env is git-ignored.
# Secrets may instead be stored in Windows Credential Manager:
#   .venv\Scripts\python scripts\set_secret.py DHAN_ACCESS_TOKEN
# Lookup order: environment / .env first, then Credential Manager (service "NiftyTradingAI").

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Historical import source (read-only). Prefer a dedicated read-only PostgreSQL role.
PG_HOST=localhost
PG_PORT=5432
PG_DB=optionchain_db
PG_USER=
PG_PASSWORD=

# Phase 8
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
